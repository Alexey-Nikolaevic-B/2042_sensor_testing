<?xml version="1.0" ?>
<!--
  Что это:
  - Переиспользуемая сцена C1 (одиночный объект) для mono RGB камер.
  - Сцена содержит только окружение и один красный куб `test_cube`.
    Позиция куба по X меняется во время теста через /gazebo/set_model_state.

  Как запускать:
  - roslaunch scenario_test_pkg scene_c1.launch

  Топики:
  - Камера в world не зашита. Топик изображения задается выбранной SDF-камерой в launch.

  Тест:
  - scripts/test_camera_c1_size_order.py (функция run_test_c1)
-->
<sdf version="1.6">
  <world name="c1_single_cube">
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.5 0.5 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane_c1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="test_cube">
      <!-- Базовая позиция; тест перед кадром выставляет X=1/3/5 -->
      <pose>3.0 0.0 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
