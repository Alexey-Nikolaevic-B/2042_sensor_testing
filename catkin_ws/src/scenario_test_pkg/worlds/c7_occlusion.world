<?xml version="1.0" ?>
<!--
  Что это:
  - Переиспользуемая сцена C7 (частичное перекрытие) для mono RGB камер.
  - Два куба: front (красный) и back (синий). Смещение back cube по Y
    задается во время теста через /gazebo/set_model_state.

  Как запускать:
  - roslaunch scenario_test_pkg scene_c7.launch

  Топики:
  - Камера в world не зашита. Топик изображения задается выбранной SDF-камерой в launch.

  Тест:
  - scripts/test_camera_c7_occlusion.py (функция run_test_c7)
-->
<sdf version="1.6">
  <world name="c7_occlusion">
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.5 0.5 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="ground_plane_c7">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="front_cube">
      <pose>3.0 0.0 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="back_cube">
      <!-- Базовое смещение; тест переключает Y=0.10 (25%) и Y=0.20 (50%) -->
      <pose>3.0 0.10 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
