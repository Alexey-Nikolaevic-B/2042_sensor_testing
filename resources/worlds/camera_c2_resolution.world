<?xml version="1.0" ?>
<!--
  Что это:
  - Сцена C2 для проверки разрешающей способности камеры.
  - Две контрастные сферы в плоскости X=3.0; расстояние между ними по Y меняется тестом.

  Как используется:
  - Тест двигает `sphere_b` через /gazebo/set_model_state по Y: 0.20, 0.15, 0.10, 0.05, 0.02.
  - Камера в world не добавляется, подключается существующим механизмом симулятора.

  Model names:
  - sphere_a, sphere_b
-->
<sdf version="1.6">
  <world name="camera_c2_resolution">
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.5 0.5 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="sphere_a">
      <pose>3.0 0.0 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="sphere_b">
      <pose>3.0 0.20 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.035</radius></sphere>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
