<?xml version="1.0" ?>
<!--
  Что это:
  - Сцена C6 для проверки чувствительности к малым смещениям объекта.
  - В сцене один куб `shift_cube`.

  Как используется:
  - Тест сдвигает `shift_cube` по X в диапазоне 2.0..1.0 с шагом 0.01 через /gazebo/set_model_state.
  - Камера в world не добавляется, подключается существующим механизмом симулятора.

  Model names:
  - shift_cube
-->
<sdf version="1.6">
  <world name="camera_c6_small_shifts">
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.5 0.5 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="shift_cube">
      <pose>2.0 0.0 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.75 0.1 1</ambient>
            <diffuse>0.95 0.75 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
