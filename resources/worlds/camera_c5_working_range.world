<?xml version="1.0" ?>
<!--
  Что это:
  - Сцена C5 для проверки рабочего диапазона по дистанции.
  - В сцене один куб `range_cube`.

  Как используется:
  - Тест сдвигает `range_cube` по X в диапазоне 0.5..10.0 с шагом 0.5 через /gazebo/set_model_state.
  - Камера в world не добавляется, подключается существующим механизмом симулятора.

  Model names:
  - range_cube
-->
<sdf version="1.6">
  <world name="camera_c5_working_range">
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.5 0.5 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="range_cube">
      <pose>0.5 0.0 0.25 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.9 0.2 1</ambient>
            <diffuse>0.2 0.9 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
