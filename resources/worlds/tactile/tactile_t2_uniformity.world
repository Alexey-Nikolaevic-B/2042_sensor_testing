<?xml version="1.0" ?>
<!--
  T2 — response uniformity on a 0.05 x 0.05 m active area sampled on a 3 x 3 grid.
  Grid markers are visual-only diagnostics; the tactile runner applies loads by code.
-->
<sdf version="1.6">
  <world name="tactile_t2_uniformity">
    <scene>
      <ambient>0.78 0.78 0.78 1</ambient>
      <background>0.95 0.95 0.98 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="t2_mount_base">
      <static>true</static>
      <pose>0 0 -0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.20 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.20 0.20 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.32 0.35 0.39 1</ambient>
            <diffuse>0.32 0.35 0.39 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="t2_active_zone">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>0.10 0.45 0.75 0.25</ambient>
            <diffuse>0.10 0.45 0.75 0.25</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="t2_grid_markers">
      <static>true</static>
      <pose>0 0 0.006 0 0 0</pose>
      <link name="link">
        <visual name="marker_11">
          <pose>-0.025 -0.025 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.90 0.20 0.20 1</ambient><diffuse>0.90 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="marker_12">
          <pose>0 -0.025 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.90 0.45 0.20 1</ambient><diffuse>0.90 0.45 0.20 1</diffuse></material>
        </visual>
        <visual name="marker_13">
          <pose>0.025 -0.025 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.90 0.75 0.20 1</ambient><diffuse>0.90 0.75 0.20 1</diffuse></material>
        </visual>
        <visual name="marker_21">
          <pose>-0.025 0 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.55 0.82 0.18 1</ambient><diffuse>0.55 0.82 0.18 1</diffuse></material>
        </visual>
        <visual name="marker_22">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.0025</radius></sphere>
          </geometry>
          <material><ambient>0.15 0.80 0.30 1</ambient><diffuse>0.15 0.80 0.30 1</diffuse></material>
        </visual>
        <visual name="marker_23">
          <pose>0.025 0 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.15 0.75 0.65 1</ambient><diffuse>0.15 0.75 0.65 1</diffuse></material>
        </visual>
        <visual name="marker_31">
          <pose>-0.025 0.025 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.15 0.60 0.85 1</ambient><diffuse>0.15 0.60 0.85 1</diffuse></material>
        </visual>
        <visual name="marker_32">
          <pose>0 0.025 0 0 0 0</pose>
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material><ambient>0.35 0.45 0.90 1</ambient><diffuse>0.35 0.45 0.90 1</diffuse></material>
        </visual>
        <visual name="marker_33">
