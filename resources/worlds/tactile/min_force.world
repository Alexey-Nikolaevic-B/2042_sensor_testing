<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tactile_min_force">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- Наконечник, по условиям теста: диаметр 0.01 м, перпендикулярен поверхности датчика (ось по Z) -->
    <model name="presser">
      <pose>0 0 0.01 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.005</radius><length>0.01</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.005</radius><length>0.01</length></cylinder>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
