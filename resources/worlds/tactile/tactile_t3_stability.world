<?xml version="1.0" ?>
<!--
  T3 — long-hold stability test world.
  A static mount and visual reference frame are provided; the runner applies the
  sustained load and records a time series.
-->
<sdf version="1.6">
  <world name="tactile_t3_stability">
    <scene>
      <ambient>0.74 0.74 0.74 1</ambient>
      <background>0.93 0.94 0.97 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="t3_mount_base">
      <static>true</static>
      <pose>0 0 -0.035 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.22 0.22 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.22 0.22 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.34 0.36 0.40 1</ambient>
            <diffuse>0.34 0.36 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="t3_reference_frame">
      <static>true</static>
      <pose>0 0 0.08 0 0 0</pose>
      <link name="link">
        <visual name="x_axis">
          <pose>0.04 0 0 0 1.57079632679 0</pose>
          <geometry><cylinder><radius>0.002</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.85 0.20 0.20 1</ambient><diffuse>0.85 0.20 0.20 1</diffuse></material>
        </visual>
        <visual name="y_axis">
          <pose>0 0.04 0 1.57079632679 0 0</pose>
          <geometry><cylinder><radius>0.002</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.20 0.80 0.25 1</ambient><diffuse>0.20 0.80 0.25 1</diffuse></material>
        </visual>
        <visual name="z_axis">
          <pose>0 0 0.04 0 0 0</pose>
          <geometry><cylinder><radius>0.002</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.20 0.35 0.85 1</ambient><diffuse>0.20 0.35 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
