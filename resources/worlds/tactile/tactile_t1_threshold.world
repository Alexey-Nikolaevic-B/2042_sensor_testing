<?xml version="1.0" ?>
<!--
  T1 — minimum stable actuation threshold for tactile / force-torque sensors.
  The sensor itself is spawned separately by the tactile runner from
  resources/sensors/tactile/<sensor_name>/model.sdf.

  Engineering intent:
  - horizontal sensor placement at world origin;
  - static mount geometry below the origin to reduce drift after spawn;
  - no camera/RFID assets are reused.
-->
<sdf version="1.6">
  <world name="tactile_t1_threshold">
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.92 0.92 0.96 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="t1_mount_base">
      <static>true</static>
      <pose>0 0 -0.03 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.18 0.18 0.04</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.18 0.18 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.37 0.40 1</ambient>
            <diffuse>0.35 0.37 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="t1_alignment_ring">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.17 0.19 0.22 0.25</ambient>
            <diffuse>0.17 0.19 0.22 0.25</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="t1_force_axis_marker">
      <static>true</static>
      <pose>0 0 0.18 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.003</radius>
              <length>0.18</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.15 0.15 1</ambient>
            <diffuse>0.85 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
