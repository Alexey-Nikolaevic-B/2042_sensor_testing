<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tactile_sensor">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="tactile_link">
      <collision name="tactile_collision">
        <geometry>
          <box><size>0.02 0.02 0.005</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.02 0.02 0.005</size></box>
        </geometry>
      </visual>
      <sensor name="tactile_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>tactile_collision</collision>
        </contact>
        <plugin name="tactile_bumper" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/tactile_sensor</namespace>
            <remapping>bumper_states:=bumper_states</remapping>
          </ros>
          <frame_name>tactile_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
