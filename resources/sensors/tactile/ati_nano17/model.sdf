<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ati_nano17">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <link name="body">
      <inertial>
        <mass>0.00907</mass>
        <inertia>
          <ixx>3.227406250000e-07</ixx>
          <iyy>3.227406250000e-07</iyy>
          <izz>3.276537500000e-07</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.0085</radius>
            <length>0.0145</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.0085</radius>
            <length>0.0145</length>
          </cylinder>
        </geometry>
      </visual>
      <!-- Rated limits: Fx/Fy 50 N, Fz 70 N, Mx/My 0.5 Nm, Mz 0.5 Nm -->
      <sensor name="ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <visualize>false</visualize>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </link>
  </model>
</sdf>
