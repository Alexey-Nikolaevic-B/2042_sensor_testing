<?xml version="1.0"?>
<sdf version="1.6">
  <model name="amti_he6x6_force_plate">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <link name="mount">
      <gravity>false</gravity>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>1.0</ixx>
          <iyy>1.0</iyy>
          <izz>1.0</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="body">
      <inertial>
        <mass>0.73</mass>
        <inertia>
          <ixx>1.456654166667e-03</ixx>
          <iyy>1.456654166667e-03</iyy>
          <izz>2.810986666667e-03</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.152 0.152 0.029</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.152 0.152 0.029</size>
          </box>
        </geometry>
      </visual>
    </link>
    <joint name="ft_joint" type="fixed">
      <parent>mount</parent>
      <child>body</child>
      <sensor name="ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <visualize>false</visualize>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </joint>
  </model>
</sdf>
