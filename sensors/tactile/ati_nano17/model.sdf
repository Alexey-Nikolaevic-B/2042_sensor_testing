<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ati_nano17">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <link name="mount">
      <gravity>false</gravity>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="body">
      <inertial>
        <mass>0.00907</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="tactile_collision">
        <geometry>
          <cylinder>
            <radius>0.0085</radius>
            <length>0.0145</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.0085</radius>
            <length>0.0145</length>
          </cylinder>
        </geometry>
      </visual>
      <sensor name="tactile_bumper" type="contact">
        <always_on>1</always_on>
        <update_rate>50.0</update_rate>
        <contact>
          <collision>tactile_collision</collision>
        </contact>
        <plugin name="tactile_bumper_plugin" filename="libgazebo_ros_bumper.so">
          <robotNamespace>/ati_nano17</robotNamespace>
          <topicName>bumper_states</topicName>
          <frameName>body</frameName>
        </plugin>
      </sensor>
    </link>
    <joint name="ft_joint" type="fixed">
      <parent>mount</parent>
      <child>body</child>
      <sensor name="ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <visualize>false</visualize>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </joint>
  </model>
</sdf>
