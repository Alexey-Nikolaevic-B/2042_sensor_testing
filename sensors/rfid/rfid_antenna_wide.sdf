<?xml version="1.0"?>
<sdf version="1.6">
  <model name="rfid_antenna">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>

    <link name="base_link_sim">

      <!-- Tag spawner plugin — reads map.txt and spawns tag models into Gazebo -->
      <sensor name="rfid_tags_dummy" type="ray">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>50</max>
          </range>
        </ray>

        <plugin name="rfid_tags" filename="libRFID_tag_plugin.so">
          <tag_name>rfid_tag</tag_name>
          <parent_frame>base_link_sim</parent_frame>
          <tags_per_fix>1</tags_per_fix>

          <map_path>package://rfid_tag_plugin/map_layouts/map.txt</map_path>
          <fix_sdf_path>package://rfid_tag_plugin/../Models/normal_size_fixture/model.sdf</fix_sdf_path>
          <tag_sdf_path>package://rfid_tag_plugin/../Models/RFID_1/model.sdf</tag_sdf_path>

          <randomize>false</randomize>

          <dynamic_tf>true</dynamic_tf>
          <tf_rate>20</tf_rate>
        </plugin>
      </sensor>

      <!-- Antenna detection plugin — publishes detected tags to /detected_tags -->
      <sensor name="rfid_antenna_dummy" type="ray">
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.01</min>
            <max>50</max>
          </range>
        </ray>

        <plugin name="rfid_antenna" filename="libRFID_antenna_plugin.so">
          <parent_frame>base_link_sim</parent_frame>
          <antenna_xyz>0 0 0</antenna_xyz>

          <antenna_name>antenna_</antenna_name>
          <antenna_id>1</antenna_id>

          <tag_name>rfid_tag</tag_name>

          <detected_topic>/detected_tags</detected_topic>

          <event_only>false</event_only>

          <deterministic>true</deterministic>
          <deterministic_threshold>0.5</deterministic_threshold>

          <spawn_visual_markers>false</spawn_visual_markers>

          <!--
            Широкоугольная антенна для тестирования.
            beamwidth = 2*pi (полная сфера 360°) — видит теги во всех направлениях.
            rzero = 3м — совпадает с дефолтным значением в тестах.
          -->
          <azimuth_beamwidth>6.28318</azimuth_beamwidth>
          <elevation_beamwidth>6.28318</elevation_beamwidth>
          <rzero>3</rzero>

          <tag_yellow_sdf_path>package://rfid_tag_plugin/../Models/RFID_3/model.sdf</tag_yellow_sdf_path>
          <tag_red_sdf_path>package://rfid_tag_plugin/../Models/RFID_2/model.sdf</tag_red_sdf_path>
          <tag_blue_sdf_path>package://rfid_tag_plugin/../Models/RFID_5/model.sdf</tag_blue_sdf_path>
          <tag_purple_sdf_path>package://rfid_tag_plugin/../Models/RFID_4/model.sdf</tag_purple_sdf_path>

          <max_tags>50</max_tags>
          <stop_after_misses>5</stop_after_misses>
        </plugin>
      </sensor>

    </link>
  </model>
</sdf>
