<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  <model name="observer_camera">
    <pose>0 -2.4 2 0 0.5 1.5708</pose>
    <static>true</static>
    <link name="observer_link">
      <sensor name="observer_cam" type="camera">
        <always_on>1</always_on>
        <update_rate>31</update_rate>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>

        <plugin name="observer_camera_plugin" filename="libgazebo_ros_camera.so">
          <cameraName>observer</cameraName>
          <ros>
            <namespace>/observer</namespace>
            <argument>camera_info:=camera_info</argument>
            <argument>camera_info:=camera_info</argument>
          </ros>
          <frame_name>observer_frame</frame_name>
          <optical_frame_id>observer_frame</optical_frame_id>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>