<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tactile_sensor">
    <pose>0 0 0.1 0 0 0</pose>
    <static>false</static>
    
    <link name="tactile_link">
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      
      <collision name="tactile_collision">
        <geometry>
          <box><size>0.02 0.02 0.005</size></box>
        </geometry>
      </collision>
      
      <visual name="visual">
        <geometry>
          <box><size>0.02 0.02 0.005</size></box>
        </geometry>
      </visual>
      
      <sensor name="tactile_bumper" type="contact">
        <always_on>1</always_on>
        <update_rate>50.0</update_rate>
        <contact>
          <collision>tactile_collision</collision>
        </contact>
        <plugin name="tactile_bumper_plugin" filename="libgazebo_ros_bumper.so">
          <!-- This adds the namespace prefix to all topics -->
          <robotNamespace>/tactile_sensor</robotNamespace>
          <!-- Topic name without leading slash - will become /tactile_sensor/bumper_states -->
          <topicName>bumper_states</topicName>
          <frameName>tactile_link</frameName>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>