<?xml version="1.0"?>
<sdf version="1.6">
  <model name="amti_he6x6_force_plate">
    <!--
      Fixed using the same two‑link design as the working Leptrino sensor:
        - mount : heavy, gravity=false, no collision. Acts as rigid base.
        - body  : sensing box. Has collision + bumper sensor.
      A fixed joint connects mount → body. The model is held in place by a
      world joint (added in the world file, e.g., tactile_force.world).

      Geometry:
        Box size: 0.152 x 0.152 x 0.029 (half‑height = 0.0145)
        Body link pose: centre at z = 0.0145 so bottom face is flush with ground.
    -->
    <pose>0 0 0 0 0 0</pose>

    <!-- ────────────────────────────────────────────────────────────────── -->
    <!--  MOUNT LINK – rigid base, no collision, anchored to world         -->
    <!-- ────────────────────────────────────────────────────────────────── -->
    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ────────────────────────────────────────────────────────────────── -->
    <!--  BODY LINK – the sensing plate                                   -->
    <!-- ────────────────────────────────────────────────────────────────── -->
    <link name="body">
      <!-- Centre at z = half height = 0.0145 → bottom face z=0, top face z=0.029 -->
      <pose>0 0 0.0145 0 0 0</pose>
      <inertial>
        <mass>0.73</mass>
        <inertia>
          <!-- Solid box inertia: ixx = m*(h²+d²)/12, etc. Approximate values -->
          <ixx>0.0015</ixx>
          <iyy>0.0015</iyy>
          <izz>0.0028</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="tactile_collision">
        <geometry>
          <box>
            <size>0.152 0.152 0.029</size>
          </box>
        </geometry>
        <!--  Contact parameters copied from working Leptrino sensor  -->
        <surface>
          <contact>
            <ode>
              <kp>50000.0</kp>          <!-- surface stiffness -->
              <kd>100.0</kd>             <!-- damping -->
              <max_vel>0.01</max_vel>
              <min_depth>0.0001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- Bounding size for test framework -->
      <sensor_size>0.152 0.152 0.029</sensor_size>
      <!-- shape param: tells test framework this is a box, not a cylinder.
           Without this, equal w=d would be misclassified as cylinder. -->
      <shape>box</shape>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.152 0.152 0.029</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
      </visual>

      <!-- Contact sensor (bumper) – same as Leptrino -->
      <sensor name="tactile_bumper" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <contact><collision>tactile_collision</collision></contact>
        <plugin name="tactile_bumper_plugin" filename="libgazebo_ros_bumper.so">
          <robotNamespace>/amti_he6x6_force_plate</robotNamespace>
          <topicName>bumper_states</topicName>
          <frameName>body</frameName>
        </plugin>
      </sensor>
    </link>

    <!--
      World joint: pins mount to the Gazebo world frame.
      Declared here in the model SDF so the world file needs no hardcoded
      sensor name — any sensor using this pattern is automatically held.
      SDF 1.6 supports <parent>world</parent> inside a model-level joint.
    -->
    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>mount</child>
    </joint>

    <!--  Fixed joint connecting mount to body  -->
    <joint name="ft_joint" type="fixed">
      <parent>mount</parent>
      <child>body</child>
      <!--  Force/torque sensor remains on the joint  -->
      <sensor name="ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>1000.0</update_rate>
        <visualize>false</visualize>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </joint>

  </model>
</sdf>