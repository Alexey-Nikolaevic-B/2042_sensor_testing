<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="zed_mini_model">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>

    <link name="stereo_link">
      <collision name="collision">
        <geometry><box><size>0.10 0.02 0.03</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.10 0.02 0.03</size></box></geometry>
      </visual>

      <sensor name="zed_mini_left" type="camera">
        <pose>0 0.0315 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera name="zed_mini_left">
          <horizontal_fov>1.78</horizontal_fov>
          <image>
            <width>1920.0</width>
            <height>1080.0</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>20.0</far>
          </clip>
        </camera>
        <plugin name="zed_mini_left_plugin" filename="libgazebo_ros_camera.so">
          <cameraName>zed_mini_left</cameraName>
          <ros>
            <namespace>/zed_mini/left</namespace>
            <argument>image_raw:=image_raw</argument>
            <argument>camera_info:=camera_info</argument>
          </ros>
          <frame_name>zed_mini_left_optical_frame</frame_name>
          <optical_frame_id>zed_mini_left_optical_frame</optical_frame_id>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>

      <sensor name="zed_mini_right" type="camera">
        <pose>0 -0.0315 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera name="zed_mini_right">
          <horizontal_fov>1.780</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.3</near>
            <far>20.0</far>
          </clip>
        </camera>
        <plugin name="zed_mini_right_plugin" filename="libgazebo_ros_camera.so">
          <cameraName>zed_mini_right</cameraName>
          <ros>
            <namespace>/zed_mini/right</namespace>
            <argument>image_raw:=image_raw</argument>
            <argument>camera_info:=camera_info</argument>
          </ros>
          <frame_name>zed_mini_right_optical_frame</frame_name>
          <optical_frame_id>zed_mini_right_optical_frame</optical_frame_id>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
