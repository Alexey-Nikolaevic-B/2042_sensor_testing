<?xml version="1.0"?>
<sdf version="1.6">
  <model name="leptrino_cfs018ca101u">
    <!--
      Two-link design: mount (rigid base) + body (sensing cylinder).
      Held in place by world_fixed joint below — NOT static=true.

      static=true makes ODE treat the body as infinite-mass wall: contact
      forces become constant constraint reactions regardless of penetration
      depth. A world joint lets ODE compute real spring forces (kp × depth).

      Geometry:
        Cylinder radius 9mm, length 26mm.
        Body link pose: centre at z=0.013 → bottom z=0, top z=0.026.
    -->
    <pose>0 0 0 0 0 0</pose>

    <link name="mount">
      <pose>0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>

    <link name="body">
      <!-- Centre at z=0.013 → bottom z=0, top z=0.026 -->
      <pose>0 0 0.013 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="tactile_collision">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.026</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>50000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.0001</min_depth>
            </ode>
          </contact>
          <friction>
            <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
          </friction>
        </surface>
      </collision>

      <!--
        sensor_size: used by test framework to determine geometry.
        For cylindrical sensors, width=depth=diameter, height=length.
        shape=cylinder tells _parse_sensor_shape() not to use the
        square-vs-cylinder heuristic.
      -->
      <sensor_size>0.018 0.018 0.026</sensor_size>
      <shape>cylinder</shape>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.009</radius>
            <length>0.026</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.5 0.8 1</ambient>
          <diffuse>0.2 0.5 0.8 1</diffuse>
        </material>
      </visual>

      <sensor name="tactile_bumper" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <contact><collision>tactile_collision</collision></contact>
        <plugin name="tactile_bumper_plugin" filename="libgazebo_ros_bumper.so">
          <robotNamespace>/leptrino_cfs018ca101u</robotNamespace>
          <topicName>bumper_states</topicName>
          <frameName>body</frameName>
        </plugin>
      </sensor>
    </link>

    <!--
      Pins mount to the Gazebo world frame.
      Declared here so world files need no hardcoded sensor name.
      SDF 1.6 supports <parent>world</parent> inside a model joint.
    -->
    <joint name="world_fixed" type="fixed">
      <parent>world</parent>
      <child>mount</child>
    </joint>

    <joint name="ft_joint" type="fixed">
      <parent>mount</parent>
      <child>body</child>
    </joint>

  </model>
</sdf>