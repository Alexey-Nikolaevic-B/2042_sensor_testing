<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="axis_wide_110deg_model">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="camera_link">
      <collision name="collision">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      </visual>
      <sensor name="axis_wide_110deg" type="camera">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera name="axis_wide_110deg">
          <image>
            <width>1920.0</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <plugin name="axis_wide_110deg_camera_plugin" filename="libgazebo_ros_camera.so">
          <cameraName>axis_wide_110deg</cameraName>
          <ros>
            <namespace>/axis_wide_110deg</namespace>
            <argument>image_raw:=image_raw</argument>
            <argument>camera_info:=camera_info</argument>
          </ros>
          <frame_name>axis_wide_110deg_optical_frame</frame_name>
          <optical_frame_id>axis_wide_110deg_optical_frame</optical_frame_id>
          <update_rate>30</update_rate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
