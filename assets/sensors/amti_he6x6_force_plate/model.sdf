<?xml version="1.0"?>
<sdf version="1.6">
  <model name="amti_he6x6_force_plate">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <link name="mount">
      <gravity>false</gravity>
      <inertial>
        <mass>1000.0</mass>
        <inertia>
          <ixx>1.0</ixx><iyy>1.0</iyy><izz>1.0</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
    </link>
    <link name="body">
      <!-- Lift body so the collision (height 0.029) sits flush on ground.
           Without this pose, the box is half below z=0 and generates
           constant ground-plane contact forces. -->
      <pose>0 0 0.0145 0 0 0</pose>
      <inertial>
        <mass>0.73</mass>
        <inertia>
          <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="tactile_collision">
        <geometry>
          <box>
            <size>0.152 0.152 0.029</size>
          </box>
        </geometry>
      </collision>
      <!-- Bounding size for test framework -->
      <sensor_size>0.152 0.152 0.029</sensor_size>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.152 0.152 0.029</size>
          </box>
        </geometry>
      </visual>
      <sensor name="tactile_bumper" type="contact">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <contact>
          <collision>tactile_collision</collision>
        </contact>
        <plugin name="tactile_bumper_plugin" filename="libgazebo_ros_bumper.so">
          <robotNamespace>/amti_he6x6_force_plate</robotNamespace>
          <topicName>bumper_states</topicName>
          <frameName>body</frameName>
        </plugin>
      </sensor>
    </link>
    <joint name="ft_joint" type="fixed">
      <parent>mount</parent>
      <child>body</child>
      <sensor name="ft_sensor" type="force_torque">
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <visualize>false</visualize>
        <force_torque>
          <frame>child</frame>
          <measure_direction>child_to_parent</measure_direction>
        </force_torque>
      </sensor>
    </joint>
    <!-- Pin mount rigidly to world frame so the sensor cannot drift under
         probe contact or body gravity.  Without this, heavy bodies pull
         the whole assembly down during scene settle and the probe sweep
         misses the sensor. -->
    <joint name="world_anchor" type="fixed">
      <parent>world</parent>
      <child>mount</child>
    </joint>
  </model>
</sdf>
