<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="camera_depth_accuracy">
    
    <!-- Include sun and ground plane -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Camera mounting point (the sensor will be inserted here) -->
    <model name="camera_mount">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.5 0 0 0</pose>  <!-- Camera at 0.5m height, facing +X -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- Target wall at exactly 3.0 meters from camera -->
    <model name="target_wall">
      <static>true</static>
      <link name="link">
        <pose>3.0 0 0.5 0 0 0</pose>  <!-- 3m in +X direction from camera -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 2.0 2.0</size>  <!-- Thin wall, 2x2 meters surface -->
            </box>
          </geometry>
          <material>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 2.0 2.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    
    <!-- Optional: Add some reference markers at different distances -->
    <model name="marker_1m">
      <static>true</static>
      <link name="link">
        <pose>1.0 -0.5 0.3 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 0 0 1</diffuse>  <!-- Red -->
          </material>
        </visual>
      </link>
    </model>
    
    <model name="marker_2m">
      <static>true</static>
      <link name="link">
        <pose>2.0 0.5 0.3 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0 1 0 1</diffuse>  <!-- Green -->
          </material>
        </visual>
      </link>
    </model>
    
    <model name="marker_3m">
      <static>true</static>
      <link name="link">
        <pose>3.0 -0.5 0.3 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <diffuse>0 0 1 1</diffuse>  <!-- Blue -->
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Add some ambient lighting -->
    <include>
      <uri>model://sun</uri>
      <pose>0 0 10 0 0 0</pose>
    </include>
    
    <!-- Physics settings -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    
    <!-- Scene settings -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.1 0.1 0.1 1</background>
      <shadows>true</shadows>
    </scene>
    
  </world>
</sdf>