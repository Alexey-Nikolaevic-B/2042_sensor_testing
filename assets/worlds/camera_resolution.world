<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="camera_resolution">
    
    <!-- Sun and ground plane -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Camera mounting point -->
    <model name="camera_mount">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.5 0 0 0</pose>  <!-- Camera at 0.5m height, facing +X -->
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
          </inertia>
        </inertial>
      </link>
    </model>
    
    <!-- Sphere A - will be positioned dynamically by the test -->
    <model name="sphere_a">
      <static>true</static>
      <link name="link">
        <pose>3.0 0 0.5 0 0 0</pose>  <!-- Initial position, will be moved -->
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- 5cm radius spheres -->
            </sphere>
          </geometry>
          <material>
            <diffuse>1 0 0 1</diffuse>  <!-- Red -->
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>
    
    <!-- Sphere B - will be positioned dynamically by the test -->
    <model name="sphere_b">
      <static>true</static>
      <link name="link">
        <pose>3.0 0.2 0.5 0 0 0</pose>  <!-- Initial position, will be moved -->
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.05</radius>  <!-- 5cm radius spheres -->
            </sphere>
          </geometry>
          <material>
            <diffuse>0 0 1 1</diffuse>  <!-- Blue -->
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
        </collision>
      </link>
    </model>
    
    <!-- Background grid for better contrast and reference -->
    <model name="background_grid">
      <static>true</static>
      <link name="link">
        <pose>3.0 0 0.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>2 2</size>
            </plane>
          </geometry>
          <material>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <ambient>0.2 0.2 0.2</ambient>
            <script>
              <uri>model://grid/materials/scripts/grid.material</uri>
              <name>Grid/Default</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Add some ambient markers at different distances for context -->
    <model name="distance_marker_1">
      <static>true</static>
      <link name="link">
        <pose>1.0 0.8 0.2 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="distance_marker_2">
      <static>true</static>
      <link name="link">
        <pose>2.0 0.8 0.2 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="distance_marker_3">
      <static>true</static>
      <link name="link">
        <pose>3.0 0.8 0.2 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Additional lighting for better visibility -->
    <light name="spotlight" type="directional">
      <pose>2 0 3 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0 -1</direction>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.2</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>
    
    <!-- Physics settings -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    
    <!-- Scene settings -->
    <scene>
      <ambient>0.3 0.3 0.3 1</ambient>
      <background>0.05 0.05 0.05 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>
    
  </world>
</sdf>