<?xml version="1.0" ?>
<!--
  Что это:
  - Сцена C2 для проверки разрешающей способности камеры.
-->
<sdf version="1.6">
  <world name="camera_c2_resolution">
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.5 0.5 0.5 1</background>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>
  </world>
</sdf>
