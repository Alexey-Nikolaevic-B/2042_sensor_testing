<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tactile_force_test">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <light name="ambient_light" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- Mounting platform for the sensor -->
    <model name="mounting_platform">
      <pose>0 0 0.05 0 0 0</pose>
      <static>true</static>
      <link name="platform_link">
        <collision name="platform_collision">
          <geometry><box><size>0.1 0.1 0.01</size></box></geometry>
        </collision>
        <visual name="platform_visual">
          <geometry><box><size>0.1 0.1 0.01</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Force probe -->
    <model name="force_probe">
      <pose>0 0 0.15 0 0 0</pose>
      <static>false</static>
      <link name="probe_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1e-6</ixx><iyy>1e-6</iyy><izz>1e-6</izz>
          </inertia>
        </inertial>
        <collision name="probe_tip">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry><sphere><radius>0.003</radius></sphere></geometry>
          <surface>
            <contact><ode><kd>1000000.0</kd><kp>1000000.0</kp></ode></contact>
          </surface>
        </collision>
        <visual name="probe_shaft">
          <geometry><cylinder><radius>0.0015</radius><length>0.02</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        <visual name="probe_tip_visual">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry><sphere><radius>0.003</radius></sphere></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.3 0.9 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

  </world>
</sdf>
