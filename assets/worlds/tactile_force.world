<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tactile_force_test">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <light name="ambient_light" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!--
      ══════════════════════════════════════════════════════════════════
      FORCE PROBE — flat disc, no tip offset
      ══════════════════════════════════════════════════════════════════
      Previous design (sphere on a stick) had two fatal problems:
        1. The stick created rotational inertia. Any lateral contact force
           rotated the disc around its centre, changing effective tip Z
           unpredictably.
        2. The 10 mm tip offset meant set_model_state had to be corrected
           by PROBE_TIP_OFFSET in the script. Any rotation invalidated that
           correction, causing the 3-10 mm drift seen in the logs.

      New design: thin disc (cylinder, 2 mm thick, 8 mm radius).
        - Collision face is the bottom face of the disc.
        - Bottom face Z = link_origin_Z - disc_half_thickness
          = link_origin_Z - 0.001
        - PROBE_TIP_OFFSET in tactile_tests.py → 0.001 (half thickness).
        - No stick → no lever arm → no rotation under lateral forces.
        - Large flat face covers full sensor top (sensor radius 9 mm,
          disc radius 8 mm) so alignment tolerance is high.
        - gravity=false + velocity zeroed in _set_pose → stays exactly
          where placed between capture_data windows.
    -->
    <model name="force_probe">
      <pose>0 0 0.10 0 0 0</pose>

      <link name="probe_link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <!-- Solid cylinder: ixx=iyy=m(3r²+h²)/12, izz=mr²/2 -->
            <!-- m=0.1, r=0.008, h=0.002 -->
            <ixx>1.653e-6</ixx>
            <iyy>1.653e-6</iyy>
            <izz>3.2e-6</izz>
            <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
          </inertia>
        </inertial>

        <!--
          Disc collision: cylinder of radius 8 mm, thickness 2 mm.
          No pose offset — cylinder is centred at link origin.
          Bottom face is at z = -0.001 (half thickness below origin).
          PROBE_TIP_OFFSET = 0.001 in tactile_tests.py.
        -->
        <collision name="probe_tip">
          <geometry>
            <cylinder>
              <radius>0.008</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <surface>
            <contact>
              <ode>
                <kp>10000.0</kp>
                <kd>50.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
            </friction>
          </surface>
        </collision>

        <!-- Visual matches collision exactly -->
        <visual name="probe_visual">
          <geometry>
            <cylinder>
              <radius>0.008</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.3 0.9 0.3 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!--
      ══════════════════════════════════════════════════════════════════
      SENSOR WORLD ANCHOR
      ══════════════════════════════════════════════════════════════════
      Previously there was a hard-coded joint pinning
        leptrino_cfs018ca101u::mount  ↔  world
      That only worked for leptrino.  For every other tactile sensor the
      joint silently failed (parent refers to a model that isn't in the
      scene), so `mount` was free-floating.  With <static>false</static>
      on the model, the fixed ft_joint transferred body gravity onto the
      mount, and heavier sensors (e.g. amti, body mass 0.73 kg) drifted
      several centimetres down during the 3 s scene-settle, making the
      probe sweep miss the sensor entirely — the probe appeared to pass
      through the model in the UI.

      The fix is per-sensor: each tactile model SDF now ships with its
      own <joint><parent>world</parent><child>mount</child></joint> at
      model scope.  The world no longer needs to know which sensor will
      be spawned.  Any sensor with a `mount` link will be anchored.
    -->

    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>