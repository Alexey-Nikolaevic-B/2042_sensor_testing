<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tactile_uniformity_test">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <light name="ambient_light" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!--
      ══════════════════════════════════════════════════════════════════
      POINT PROBE — small sphere for uniformity grid testing
      ══════════════════════════════════════════════════════════════════
      The large disc probe (r=8mm) used in T1 covers almost the entire
      sensor surface (sensor r=9mm). It cannot test individual grid points
      without overlapping neighbouring cells.

      This probe uses a small sphere (r=2mm) so each of the 7 grid points
      (centre + 6 on a 5mm-radius ring) is probed independently.

      Geometry:
        - Sphere radius 2mm, centred at link origin.
        - Bottom of sphere = link_origin_Z - 0.002
        - PROBE_TIP_OFFSET = 0.002 in tactile_tests.py for T2.
        - gravity=false + velocity zeroed → stays where placed.
    -->
    <model name="force_probe">
      <pose>0 0 0.10 0 0 0</pose>

      <link name="probe_link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <!-- Solid sphere: I = 2mr²/5, r=0.002 -->
            <ixx>8e-8</ixx>
            <iyy>8e-8</iyy>
            <izz>8e-8</izz>
            <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="probe_tip">
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <surface>
            <contact>
              <ode>
                <kp>10000.0</kp>
                <kd>50.0</kd>
                <max_vel>0.01</max_vel>
                <min_depth>0.0001</min_depth>
              </ode>
            </contact>
            <friction>
              <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
            </friction>
          </surface>
        </collision>

        <visual name="probe_visual">
          <geometry>
            <sphere><radius>0.002</radius></sphere>
          </geometry>
          <material>
            <ambient>1.0 0.3 0.0 1</ambient>
            <diffuse>1.0 0.4 0.0 1</diffuse>
          </material>
        </visual>
      </link>

    </model>

    <!--
      The sensor is pinned to world via its own model SDF joint.
      No hardcoded sensor name needed here.
    -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0005</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

  </world>
</sdf>