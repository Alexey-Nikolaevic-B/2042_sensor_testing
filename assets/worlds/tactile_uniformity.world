<?xml version="1.0"?>
<sdf version="1.6">
  <world name="tactile_uniformity_test">
    
    <!-- ========== ENVIRONMENT ========== -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Ambient lighting for better visibility -->
    <light name="ambient_light" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 -0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    
    <!-- ========== TEST FIXTURE ========== -->
    
    <!-- Mounting platform for the sensor -->
    <model name="mounting_platform">
      <pose>0 0 0.05 0 0 0</pose>
      <static>true</static>
      <link name="platform_link">
        <collision name="platform_collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.01</size>
            </box>
          </geometry>
        </collision>
        <visual name="platform_visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ========== GRID VISUALIZATION ========== -->
    
    <!-- Visual markers for the 3x3 grid points -->
    <model name="grid_marker_center">
      <pose>0 0 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_top_left">
      <pose>-0.0167 0.0167 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_top_center">
      <pose>0 0.0167 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_top_right">
      <pose>0.0167 0.0167 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_middle_left">
      <pose>-0.0167 0 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_middle_right">
      <pose>0.0167 0 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_bottom_left">
      <pose>-0.0167 -0.0167 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_bottom_center">
      <pose>0 -0.0167 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_marker_bottom_right">
      <pose>0.0167 -0.0167 0.08 0 0 0</pose>
      <static>true</static>
      <link name="marker">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.002</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 0.5</ambient>
            <diffuse>1 0 0 0.5</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ========== GRID LINES ========== -->
    
    <!-- Horizontal grid lines -->
    <model name="grid_line_top">
      <static>true</static>
      <link name="line">
        <pose>0 0.0167 0.08 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.001 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.3</ambient>
            <diffuse>0.5 0.5 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_line_middle">
      <static>true</static>
      <link name="line">
        <pose>0 0 0.08 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.001 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.3</ambient>
            <diffuse>0.5 0.5 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_line_bottom">
      <static>true</static>
      <link name="line">
        <pose>0 -0.0167 0.08 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.001 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.3</ambient>
            <diffuse>0.5 0.5 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- Vertical grid lines -->
    <model name="grid_line_left">
      <static>true</static>
      <link name="line">
        <pose>-0.0167 0 0.08 0 0 1.5708</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.001 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.3</ambient>
            <diffuse>0.5 0.5 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_line_center_vertical">
      <static>true</static>
      <link name="line">
        <pose>0 0 0.08 0 0 1.5708</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.001 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.3</ambient>
            <diffuse>0.5 0.5 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <model name="grid_line_right">
      <static>true</static>
      <link name="line">
        <pose>0.0167 0 0.08 0 0 1.5708</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.001 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 0.3</ambient>
            <diffuse>0.5 0.5 0.5 0.3</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ========== UNIFORMITY PROBE ========== -->
    
    <model name="uniformity_probe">
      <pose>0 0 0.15 0 0 0</pose>
      <static>false</static>
      <link name="probe_link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1e-6</ixx>
            <iyy>1e-6</iyy>
            <izz>1e-6</izz>
          </inertia>
        </inertial>
        
        <collision name="probe_tip">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.003</radius>
            </sphere>
          </geometry>
          <surface>
            <contact>
              <ode>
                <kd>1000000.0</kd>
                <kp>1000000.0</kp>
              </ode>
            </contact>
          </surface>
        </collision>
        
        <visual name="probe_shaft">
          <geometry>
            <cylinder>
              <radius>0.0015</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
        
        <visual name="probe_tip_visual">
          <pose>0 0 -0.01 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.003</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.3 0.9 0.3 1</diffuse>
          </material>
        </visual>
        
        <visual name="probe_mount">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.004</radius>
              <length>0.005</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    
    <!-- ========== PHYSICS ========== -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    
  </world>
</sdf>